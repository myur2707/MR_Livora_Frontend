{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": { "cachePolicy": "static-shell-only" },
  "assetGroups": [
    {
      "name": "application-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.js",
          "/*.css",
          "/manifest.webmanifest",
          "/favicon.svg",
          "/assets/brand/*.svg",
          "/icons/*.png"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": [
    "/$",
    "/login$",
    "/forgot-password$",
    "/reset-password$",
    "/workspace$",
    "/register$",
    "/verify-resident-email$",
    "/resident-invitation$",
    "/join-society$",
    "/society/resident-access$",
    "/platform/dashboard$",
    "/platform/societies$",
    "/platform/societies/*$",
    "/onboarding/societies/*$",
    "/accept-invitation$",
    "/society/dashboard$",
    "/society/reports/outstanding$",
    "/society/reports/collection$",
    "/society/reports/cash-collection$",
    "/society/reports/payments$",
    "/society/reports/residents$",
    "/society/reports/flat-occupancy$",
    "/society/reports/billing$",
    "/society/community/notices$",
    "/society/community/notices/new$",
    "/society/community/notices/*$",
    "/society/community/complaints$",
    "/society/community/complaints/*$",
    "/society/resident$",
    "/society/resident/dashboard$",
    "/society/resident/flats$",
    "/society/resident/flats/*$",
    "/society/resident/bills$",
    "/society/resident/bills/*$",
    "/society/resident/payments$",
    "/society/resident/receipts$",
    "/society/resident/payments/*/receipt$",
    "/society/resident/notices$",
    "/society/resident/notices/*$",
    "/society/resident/complaints$",
    "/society/resident/complaints/*$",
    "/society/resident/profile$",
    "/society/buildings$",
    "/society/flats$",
    "/society/flats/*$",
    "/society/persons$",
    "/society/imports$",
    "/society/billing/configuration$",
    "/society/billing/periods$",
    "/society/billing/generate$",
    "/society/billing/bills$",
    "/society/billing/bills/*$",
    "/society/billing/outstanding$",
    "/society/billing/payments$",
    "/society/billing/payments/new$",
    "/society/billing/payments/report$",
    "/society/billing/payments/*$",
    "/society/billing/payments/*/receipt$",
    "/society/billing/payments/*/correct$",
    "/ui$",
    "!/api$",
    "!/api/**",
    "!/bills/**",
    "!/payments/**",
    "!/receipts/**",
    "!/residents/**",
    "!/uploads/**"
  ],
  "navigationRequestStrategy": "performance"
}
