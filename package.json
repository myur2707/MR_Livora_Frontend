{
  "name": "society-ease",
  "version": "0.2.0",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1",
    "start": "npm run dev",
    "build": "ng build --configuration production",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "pwa:check": "node scripts/check-pwa.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "check": "npm run check-format && npm run lint && npm run typecheck && npm test && npm run build && npm run pwa:check"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
